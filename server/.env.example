# Server
APP_ENV=dev
SERVER_PORT=8080
SERVER_MODE=debug
SERVER_REQUEST_TIMEOUT=30s

# Database
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=weaveclip
DATABASE_PASSWORD=weaveclip_dev
DATABASE_DBNAME=weaveclip
DATABASE_SSLMODE=disable

# Redis
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# MinIO
STORAGE_PROVIDER=minio
STORAGE_ENDPOINT=localhost:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET=weaveclip
STORAGE_REGION=us-east-1

# JWT (must be set in production; empty in non-mock mode causes startup failure)
JWT_SECRET=dev_jwt_secret_change_me
JWT_EXPIRY=168h

# AI
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# FFmpeg
FFMPEG_BINARY_PATH=ffmpeg
FFPROBE_BINARY_PATH=ffprobe

# Feature flags
MOCK_MODE=false

# CORS (comma-separated, empty means allow all in dev)
CORS_ALLOWED_ORIGINS=
